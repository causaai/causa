# ============================================================
# Causa Backend — VM Environment Variables
# ============================================================
# Copy this file to .env and fill in real values BEFORE deploying.
#
#   cp deployment/vm/.env.example prod.env
#   nano prod.env
#   bash scripts/jar/deploy.sh --host <vm-ip> --env-path ./prod.env
#
# This file is transferred to the VM as /opt/causa/.env (chmod 600)
# and loaded by systemd as an EnvironmentFile before the JVM starts.
# ============================================================

# ------------------------------------------------------------
# HTTP / Server
# ------------------------------------------------------------
CAUSA_PORT=8080
CAUSA_HOST=0.0.0.0
# Comma-separated allowed CORS origins (* = allow all)
# Restrict to your OpenShift UI route in production
CAUSA_CORS_ORIGINS=*

# ------------------------------------------------------------
# Database — PostgreSQL running in OpenShift
# Use the OpenShift service route or NodePort exposed externally
CAUSA_DB_URL=jdbc:postgresql://my-db-url/iri-db
CAUSA_DB_USERNAME=causa_backend
CAUSA_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# LLM Provider
# Supported: vertex-ai-anthropic | anthropic | ollama | openai
# ------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-sonnet-4-6
LLM_API_KEY=sk-ant-api03-REPLACE_ME
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180

# Vertex AI (only when LLM_PROVIDER=vertex-ai-anthropic)
# VERTEX_PROJECT_ID=my-gcp-project
# VERTEX_LOCATION=us-east5
# GOOGLE_APPLICATION_CREDENTIALS=/opt/causa/sa-key.json

# ------------------------------------------------------------
# MCP Server Endpoints (running on the same VM or locally)
# ------------------------------------------------------------
CAUSA_MCP_K8S_ENDPOINT=http://localhost:8081
CAUSA_MCP_KRUIZE_ENDPOINT=http://localhost:8082
CAUSA_MCP_CRYOSTAT_ENDPOINT=http://localhost:8000

# ------------------------------------------------------------
# Alert Ingestion
# ------------------------------------------------------------
CAUSA_ALERT_SEVERITY=critical
CAUSA_ALERT_COOLDOWN=15
CAUSA_ALERT_IGNORE_NS=kube-system,istio-system

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
CAUSA_LOG_LEVEL=INFO
CAUSA_APP_LOG_LEVEL=INFO

# ------------------------------------------------------------
# JVM Options (optional — systemd default: -Xms256m -Xmx512m)
# Override here if your VM has more memory available
# ------------------------------------------------------------
# JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC
