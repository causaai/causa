{
  "mcpServers": {
    "kubernetes": {
      "type": "streamable-http",
      "url": "http://kubernetes-mcp-server:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["pods_get", "pods_log", "events_list"],
      "healthCheck": { "url": "http://kubernetes-mcp-server:8080/healthz", "timeoutMs": 5000 },
      "timeoutMs": 5000,
      "description": "Kubernetes MCP — live pod status, events, and container logs from the cluster API",
      "tools": [
        {
          "name": "pods_get",
          "contextKey": "POD_STATUS",
          "description": "Current pod phase, container statuses, restart counts, and resource requests/limits.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}" }
        },
        {
          "name": "events_list",
          "contextKey": "POD_EVENTS",
          "description": "Kubernetes events for the pod (Type, Reason, Message, Timestamp).",
          "arguments": { "namespace": "${namespace}", "fieldSelector": "involvedObject.name=${podName}" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS",
          "description": "Current container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "false", "tailLines": "25" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS_PREVIOUS",
          "description": "Previous (crashed/restarted) container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "true", "tailLines": "25" }
        }
      ]
    },
    "kruize": {
      "type": "streamable-http",
      "url": "http://kruize-mcp-server-service:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["getCostOptimizedRecommendations", "getPerformanceOptimizedRecommendations"],
      "healthCheck": { "url": "http://kruize-mcp-server-service:8080/q/health/ready", "timeoutMs": 10000 },
      "timeoutMs": 10000,
      "description": "Kruize MCP — CPU and memory resource optimisation recommendations",
      "tools": [
        {
          "name": "getCostOptimizedRecommendations",
          "contextKey": "KRUIZE_COST_RECOMMENDATIONS",
          "description": "Container resource-request/limit suggestions optimised for cost.",
          "arguments": { "containerName": "${containerName}", "namespace": "${namespace}" }
        },
        {
          "name": "getPerformanceOptimizedRecommendations",
          "contextKey": "KRUIZE_PERFORMANCE_RECOMMENDATIONS",
          "description": "Container resource-request/limit suggestions optimised for performance.",
          "arguments": { "containerName": "${containerName}", "namespace": "${namespace}" }
        }
      ]
    },
    "cryostat": {
      "type": "streamable-http",
      "url": "http://cryostat-mcp-cryostat-k8s-multi-mcp:8080/mcp",
      "headers": {},
      "optional": true,
      "alwaysAllow": ["getDiscoveryTree", "getAnalysisReport"],
      "healthCheck": { "url": "http://cryostat-mcp-cryostat-k8s-multi-mcp:8080/q/health/ready", "timeoutMs": 15000 },
      "timeoutMs": 60000,
      "metadata": { "analysisLookbackMinutes": 15 },
      "description": "Cryostat MCP — confirm the pod in the discovery tree, then fetch automated JFR analysis for the alert time window",
      "tools": [
        {
          "name": "getDiscoveryTree",
          "contextKey": "CRYOSTAT_DISCOVERY",
          "description": "Discovery tree for the application namespace. The report is called only when this tree contains the alert namespace and pod.",
          "arguments": { "namespace": "${namespace}", "mergeRealms": "true" }
        },
        {
          "name": "getAnalysisReport",
          "contextKey": "CRYOSTAT_ANALYSIS",
          "description": "Automated analysis rules for archived JFR recordings that intersect the alert time window.",
          "arguments": {
            "namespace": "${namespace}",
            "podName": "${podName}",
            "fromTimestamp": "${fromTimestamp}",
            "toTimestamp": "${toTimestamp}"
          }
        }
      ]
    }
  }
}
